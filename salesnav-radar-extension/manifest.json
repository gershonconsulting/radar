{
  "manifest_version": 3,
  "name": "Radar — Prospect Collector",
  "short_name": "Radar",
  "version": "1.18.3",
  "description": "Finds warm-intro prospects through your network on Sales Navigator and syncs them to your Radar account.",
  "homepage_url": "https://radar.gershon.ai",
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://pkzeeqehwmtnqxdpdesl.supabase.co/*",
    "https://enricherpro.com/*",
    "https://api.botdog.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://radar.gershon.ai/*",
        "https://radar.gershoncrm.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "sync-core.js"
  },
  "action": {
    "default_title": "Radar",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
